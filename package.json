{
  "name": "steam-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Steam Web API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "steam-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}

# Steam Web API key — https://steamcommunity.com/dev/apikey
# Required for anything account-scoped (library, achievements, friends, vanity URLs).
# Store search, app details, reviews, player counts and news work without it.
STEAM_API_KEY=

# Your SteamID64, used whenever a tool omits steam_id — https://steamdb.info/calculator/
STEAM_DEFAULT_STEAM_ID=

# Only needed for wishlist writes (add_to_wishlist / remove_from_wishlist).
# Log into Steam in a browser, open https://store.steampowered.com/pointssummary/ajaxgetasyncconfig
# and copy the "webapi_token" value. It expires roughly every 24 hours.
STEAM_ACCESS_TOKEN=

# Store region and language for prices and localized text.
STEAM_COUNTRY_CODE=US
STEAM_LANGUAGE=english
